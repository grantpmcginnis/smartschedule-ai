function splitCsvLine(line){
let result=3D[],current=3D"",inQuotes=3Dfalse;
for(let i=3D0;i&lt;line.length;i++){
let char=3Dline[i];
if(char=3D=3D=3D'"')inQuotes=3D!inQuotes;
else if(char=3D=3D=3D","&amp;&amp;!inQuotes){result.push(current.trim());cu=
rrent=3D"";}
else current+=3Dchar;
}
result.push(current.trim());
return result;
}

