function placeClass(schedule,sections,courseName){
if(!sections[courseName])return{placed:false};
let possible=3Dsections[courseName].filter(x=3D&gt;x.seats&gt;0&amp;&amp;sc=
hedule[x.period]=3D=3D=3Dnull);
possible.sort((a,b)=3D&gt;b.seats-a.seats||a.period-b.period);
if(possible.length=3D=3D=3D0)return{placed:false};
let chosen=3Dpossible[0];
schedule[chosen.period]=3D{course:courseName,teacher:chosen.teacher};
chosen.seats--;
return{placed:true};
}

function buildStudentSchedule(student,sections){
let schedule=3DcreateEmptySchedule();
let notes=3D[],received=3D[],missed=3D[];
requiredCoursesForGrade(student).forEach(course=3D&gt;{
let r=3DplaceClass(schedule,sections,course);
if(!r.placed)notes.push("Could not place required course: "+course);
});
student.rankings.forEach((course,index)=3D&gt;{
let matched=3DmatchCourse(course);
if(!matched)return;
let r=3DplaceClass(schedule,sections,matched);
if(r.placed)received.push({course:matched,rank:index+1});
else missed.push({course:matched,rank:index+1});
});
return{student,schedule,notes,receivedElectives:received,missedElectives:mi=
ssed};
}

